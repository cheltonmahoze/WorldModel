# ── Database ────────────────────────────────────────────────────────────────
# Local sandbox default (managed by `npm run db:start`, a real PostgreSQL 17 cluster).
DATABASE_URL="postgresql://nexus:nexus@127.0.0.1:55432/nexus_os?schema=public"

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME="Nexus OS"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Security ────────────────────────────────────────────────────────────────
# 32+ byte secret used to sign session cookies (openssl rand -base64 48).
SESSION_SECRET="dev-only-insecure-session-secret-change-me-please-32b"
# Token TTLs (minutes)
SESSION_TTL_MINUTES="10080"
PASSWORD_RESET_TTL_MINUTES="45"
EMAIL_VERIFICATION_TTL_MINUTES="1440"
INVITE_TTL_MINUTES="10080"
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="240"

# ── Intelligence engine ─────────────────────────────────────────────────────
# "deterministic" (default): the insight rules compute every figure and write the
# brief narrative from the tenant's own rows. No network calls, no invented text.
# "llm": the same computed facts are sent to the provider below, which may only
# rephrase them — figures, currency amounts and entity names are passed through
# untouched. If the provider is missing, unreachable or returns junk, the brief
# falls back to the deterministic narrative and says so on the record.
AI_ENGINE="deterministic"
OPENAI_MODEL="gpt-4o-mini"
# OPENAI_API_KEY=""

# ── Integrations (optional, sandbox placeholders) ───────────────────────────
# SLACK_WEBHOOK_URL=""

# ── Self-serve signup ───────────────────────────────────────────────────────
# Length of the trial workspace created when someone signs up.
TRIAL_DAYS="14"

# ── Access ──────────────────────────────────────────────────────────────────
# When "true", anyone opening the app is signed into the demo tenant automatically.
# Set to "false" to require a normal sign-in.
OPEN_WORKSPACE="true"
# Account used by the open-access entry point (defaults to the seeded owner).
# DEMO_EMAIL="alex.morgan@nexus-demo.com"
