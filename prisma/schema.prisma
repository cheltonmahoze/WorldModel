// Nexus OS — AI Revenue & Operations Intelligence Platform
// Relational schema: multi-tenant SaaS with RBAC, auditability, automation and analytics.
//
// Tenancy model:  Platform → Organization → Team → Membership(User) → Data
// Every tenant-owned row carries `organizationId` and is queried through a
// tenant-scoped data access layer (src/server/tenant.ts) so cross-tenant reads
// are structurally impossible from route handlers.

generator client {
  provider = "prisma-client-js"
  // Engine strategy: the Rust query compiler ships as WebAssembly and talks to
  // PostgreSQL through the `pg` driver adapter. No native engine binary is
  // downloaded or loaded — identical behaviour on laptops, CI and serverless,
  // and it works in air-gapped/offline environments.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum OrgPlan {
  STARTER
  GROWTH
  SCALE
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  ANALYST
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  INVITE
  MFA_CHALLENGE
}

enum CompanySegment {
  ENTERPRISE
  MID_MARKET
  SMB
  STARTUP
}

enum CustomerStatus {
  PROSPECT
  ONBOARDING
  ACTIVE
  AT_RISK
  CHURNED
}

enum HealthTrend {
  IMPROVING
  STABLE
  DECLINING
}

enum DealStage {
  DISCOVERY
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CONTRACT_SENT
  WON
  LOST
}

enum DealType {
  NEW_BUSINESS
  EXPANSION
  RENEWAL
}

enum DealSource {
  INBOUND
  OUTBOUND
  PARTNER
  REFERRAL
  PRODUCT_LED
  EVENT
  EXPANSION
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  DEMO
  TASK
  NOTE
  PROPOSAL_SENT
  QBR
}

enum ActivityDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum ActivityOutcome {
  POSITIVE
  NEUTRAL
  NEGATIVE
  NO_RESPONSE
}

enum RiskCategory {
  REVENUE
  PIPELINE
  CUSTOMER
  OPERATIONAL
  COMPLIANCE
  FINANCIAL
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum RiskStatus {
  OPEN
  MITIGATING
  MONITORING
  RESOLVED
  ACCEPTED
}

enum InsightCategory {
  REVENUE_OPPORTUNITY
  COST_REDUCTION
  CUSTOMER_RETENTION
  SALES_ACCELERATION
  OPERATIONAL_EFFICIENCY
  RISK_PREVENTION
}

enum InsightStatus {
  DETECTED
  REVIEWING
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum ExecutionStatus {
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}

enum IntegrationCategory {
  CRM
  COMMUNICATION
  FINANCE
  PRODUCTIVITY
  DATA
  SUPPORT
  MARKETING
}

enum IntegrationStatus {
  DISCONNECTED
  PENDING
  CONNECTED
  ERROR
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum NotificationType {
  OPPORTUNITY_DETECTED
  RISK_DETECTED
  TASK_ASSIGNED
  AUTOMATION_COMPLETED
  INTEGRATION_ERROR
  REPORT_GENERATED
  BRIEF_PUBLISHED
  DEAL_UPDATED
  CUSTOMER_AT_RISK
  SYSTEM
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AuditSource {
  WEB
  API
  AUTOMATION
  SYSTEM
}

enum MetricGranularity {
  DAY
  WEEK
  MONTH
  QUARTER
}

enum ReportType {
  EXECUTIVE
  REVENUE
  PIPELINE
  CUSTOMER
  OPERATIONAL
  CUSTOM
  SAVED_VIEW
}

enum ReportSchedule {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum BriefStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ─────────────────────────────────────────────────────────────────────────────
// PLATFORM / TENANCY
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  legalName          String?
  domain             String?
  industry           String?
  hqCountry          String?   @default("PT")
  companySize        String?
  plan               OrgPlan   @default(GROWTH)
  dataRegion         String    @default("eu-west-1")
  timezone           String    @default("Europe/Lisbon")
  currency           String    @default("EUR")
  locale             String    @default("en-GB")
  fiscalYearStart    Int       @default(1)
  aiEngineEnabled    Boolean   @default(true)
  churnRiskThreshold Int       @default(60)
  primaryColor       String?   @default("#4F46E5")
  logoUrl            String?
  onboardedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  memberships      Membership[]
  teams            Team[]
  teamMembers      TeamMember[]
  customers        Customer[]
  contacts         Contact[]
  opportunities    Opportunity[]
  activities       Activity[]
  tickets          SupportTicket[]
  risks            Risk[]
  insights         Insight[]
  automations      Automation[]
  executions       AutomationExecution[]
  integrations     Integration[]
  metrics          Metric[]
  reports          Report[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  subscription     Subscription?
  invoices         Invoice[]
  apiKeys          ApiKey[]
  usageEvents      UsageEvent[]
  briefs           AiBrief[]
  webhooks         Webhook[]
  webhookDeliveries WebhookDelivery[]

  @@index([deletedAt])
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  passwordHash     String?
  avatarUrl        String?
  jobTitle         String?
  phone            String?
  timezone         String    @default("Europe/Lisbon")
  locale           String    @default("en-GB")
  themePreference  String    @default("system")
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  lastActiveAt     DateTime?
  isPlatformAdmin  Boolean   @default(false)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  memberships       Membership[]
  sessions          Session[]
  authTokens        AuthToken[]
  teams             TeamMember[]
  ownedCustomers    Customer[]      @relation("CustomerOwner")
  managedCustomers  Customer[]      @relation("CustomerCsm")
  ownedDeals        Opportunity[]   @relation("DealOwner")
  activities        Activity[]
  assignedTickets   SupportTicket[] @relation("TicketAssignee")
  ownedRisks        Risk[]          @relation("RiskOwner")
  ownedInsights     Insight[]       @relation("InsightOwner")
  notifications     Notification[]  @relation("NotificationRecipient")
  auditLogs         AuditLog[]      @relation("AuditActor")
  invitedMemberships Membership[]   @relation("MembershipInviter")
  sessionsRevoked   Session[]       @relation("SessionRevoker")

  @@index([email])
  @@index([deletedAt])
}

model Membership {
  id              String           @id @default(cuid())
  userId          String
  organizationId  String
  role            Role             @default(MEMBER)
  status          MembershipStatus @default(ACTIVE)
  title           String?
  department      String?
  costCenter      String?
  invitedById     String?
  invitedEmail    String?
  inviteTokenHash String?
  inviteExpiresAt DateTime?
  invitedAt       DateTime?
  joinedAt        DateTime?
  lastSeenAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?         @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@index([inviteTokenHash])
}

model Session {
  id             String    @id @default(cuid())
  userId         String
  organizationId String?
  tokenHash      String    @unique
  ip             String?
  userAgent      String?
  device         String?
  location       String?
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedById    String?
  lastSeenAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  revokedBy User? @relation("SessionRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  email     String?
  expiresAt DateTime
  usedAt    DateTime?
  metadata  Json?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Team {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  department     String?
  color          String?   @default("#6366F1")
  leadId         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model TeamMember {
  id             String   @id @default(cuid())
  teamId         String
  userId         String
  organizationId String
  isLead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// REVENUE / CRM CORE
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id               String         @id @default(cuid())
  organizationId   String
  name             String
  code             String?
  domain           String?
  website          String?
  logoUrl          String?
  industry         String?
  segment          CompanySegment @default(MID_MARKET)
  region           String?
  country          String?
  city             String?
  companySize      String?
  employeeCount    Int?
  status           CustomerStatus @default(ACTIVE)
  plan             String?
  tier             String?
  supportTier      String?
  currency         String         @default("EUR")
  arr              Decimal        @default(0) @db.Decimal(14, 2)
  mrr              Decimal        @default(0) @db.Decimal(14, 2)
  lifetimeValue    Decimal        @default(0) @db.Decimal(14, 2)
  expansionMrr     Decimal        @default(0) @db.Decimal(14, 2)
  churnedMrr       Decimal        @default(0) @db.Decimal(14, 2)
  healthScore      Int            @default(70)
  healthTrend      HealthTrend    @default(STABLE)
  churnProbability Int            @default(10)
  engagementScore  Int            @default(70)
  supportScore     Int            @default(70)
  usageScore       Int            @default(70)
  revenueScore     Int            @default(70)
  npsScore         Int?
  openTicketCount  Int            @default(0)
  openDealCount    Int            @default(0)
  activityCount    Int            @default(0)
  ownerId          String?
  csmId            String?
  acquisitionChannel String?
  contractStart    DateTime?
  renewalDate      DateTime?
  onboardedAt      DateTime?
  lastActivityAt   DateTime?
  lastLoginAt      DateTime?
  notes            String?
  tags             String[]       @default([])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner         User?           @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  csm           User?           @relation("CustomerCsm", fields: [csmId], references: [id], onDelete: SetNull)
  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]
  tickets       SupportTicket[]
  risks         Risk[]
  invoices      Invoice[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@index([organizationId, healthScore])
  @@index([organizationId, segment])
  @@index([organizationId, renewalDate])
  @@index([deletedAt])
}

model Contact {
  id               String    @id @default(cuid())
  organizationId   String
  customerId       String
  firstName        String
  lastName         String
  email            String?
  phone            String?
  mobile           String?
  title            String?
  department       String?
  seniority        String?
  role             String?
  linkedinUrl      String?
  country          String?
  language         String?
  isPrimary        Boolean   @default(false)
  isDecisionMaker  Boolean   @default(false)
  optedOut         Boolean   @default(false)
  sentiment        String?
  engagementScore  Int       @default(60)
  timezone         String?
  lastContactedAt  DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  activities   Activity[]

  @@index([organizationId, customerId])
  @@index([organizationId, email])
  @@index([deletedAt])
}

model Opportunity {
  id               String      @id @default(cuid())
  organizationId   String
  customerId       String
  ownerId          String?
  name             String
  code             String
  stage            DealStage   @default(DISCOVERY)
  type             DealType    @default(NEW_BUSINESS)
  source           DealSource  @default(INBOUND)
  amount           Decimal     @default(0) @db.Decimal(14, 2)
  currency         String      @default("EUR")
  probability      Int         @default(20)
  weightedAmount   Decimal     @default(0) @db.Decimal(14, 2)
  aiScore          Int?
  expectedCloseDate DateTime
  closedAt         DateTime?
  stageEnteredAt   DateTime    @default(now())
  daysInStage      Int         @default(0)
  lastActivityAt   DateTime?
  activityCount    Int         @default(0)
  nextStep         String?
  nextStepDueAt    DateTime?
  competitor       String?
  lossReason       String?
  productLine      String?
  dealRegion       String?
  department       String?
  forecastCategory String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  owner        User?        @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities   Activity[]
  risks        Risk[]

  @@unique([organizationId, code])
  @@index([organizationId, stage])
  @@index([organizationId, customerId])
  @@index([organizationId, ownerId])
  @@index([organizationId, expectedCloseDate])
  @@index([organizationId, lastActivityAt])
  @@index([deletedAt])
}

model Activity {
  id              String            @id @default(cuid())
  organizationId  String
  customerId      String?
  contactId       String?
  opportunityId   String?
  userId          String?
  type            ActivityType
  direction       ActivityDirection @default(OUTBOUND)
  outcome         ActivityOutcome?
  subject         String
  body            String?
  durationMinutes Int?
  occurredAt      DateTime          @default(now())
  dueAt           DateTime?
  completedAt     DateTime?
  isOverdue       Boolean           @default(false)
  channel         String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity  Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([organizationId, customerId, occurredAt])
  @@index([organizationId, userId, occurredAt])
  @@index([organizationId, dueAt])
  @@index([deletedAt])
}

model SupportTicket {
  id                   String         @id @default(cuid())
  organizationId       String
  customerId           String
  assigneeId           String?
  reference            String
  subject              String
  description          String?
  priority             TicketPriority @default(MEDIUM)
  status               TicketStatus   @default(OPEN)
  channel              String         @default("email")
  firstResponseMinutes Int?
  resolutionMinutes    Int?
  slaTargetMinutes     Int            @default(480)
  slaBreached          Boolean        @default(false)
  csatScore            Int?
  reopenedCount        Int            @default(0)
  openedAt             DateTime       @default(now())
  firstResponseAt      DateTime?
  resolvedAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, openedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// INTELLIGENCE: OPPORTUNITY ENGINE + RISK ENGINE
// ─────────────────────────────────────────────────────────────────────────────

model Insight {
  id              String          @id @default(cuid())
  organizationId  String
  title           String
  summary         String
  category        InsightCategory
  priority        Priority        @default(MEDIUM)
  priorityScore   Int             @default(50)
  confidence      Int             @default(70)
  estimatedImpact Decimal         @default(0) @db.Decimal(14, 2)
  impactUnit      String          @default("EUR")
  impactScope     String          @default("ANNUAL")
  source          String
  signal          Json?
  recommendation  String?
  actions         Json?
  status          InsightStatus   @default(DETECTED)
  ownerId         String?
  dueAt           DateTime?
  entityType      String?
  entityId        String?
  relatedCount    Int             @default(0)
  fingerprint     String
  reviewNotes     String?
  detectedAt      DateTime        @default(now())
  acknowledgedAt  DateTime?
  completedAt     DateTime?
  dismissedAt     DateTime?
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("InsightOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, fingerprint])
  @@index([organizationId, status, priority])
  @@index([organizationId, category])
  @@index([organizationId, detectedAt])
}

model Risk {
  id             String     @id @default(cuid())
  organizationId String
  title          String
  description    String
  category       RiskCategory
  severity       Severity   @default(MEDIUM)
  status         RiskStatus @default(OPEN)
  probability    Int        @default(50)
  impact         Decimal    @default(0) @db.Decimal(14, 2)
  riskScore      Int        @default(50)
  mitigation     String?
  recommendation String?
  ownerId        String?
  customerId     String?
  opportunityId  String?
  entityType     String?
  entityId       String?
  detectedBy     String     @default("risk_engine")
  fingerprint    String
  detectedAt     DateTime   @default(now())
  dueAt          DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([organizationId, fingerprint])
  @@index([organizationId, status, severity])
  @@index([organizationId, category])
  @@index([organizationId, detectedAt])
}

model AiBrief {
  id             String      @id @default(cuid())
  organizationId String
  headline       String
  periodStart    DateTime
  periodEnd      DateTime
  whatChanged    Json
  whyItMatters   Json
  attention      Json
  recommendations Json
  metrics        Json
  engine         String      @default("nexus-deterministic-v1")
  model          String?
  confidence     Int         @default(80)
  status         BriefStatus @default(PUBLISHED)
  generatedById  String?
  generationMs   Int?
  generatedAt    DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, generatedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTOMATION
// ─────────────────────────────────────────────────────────────────────────────

model Automation {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         AutomationStatus @default(DRAFT)
  triggerType    String
  triggerConfig  Json             @default("{}")
  conditions     Json             @default("[]")
  actions        Json             @default("[]")
  tags           String[]         @default([])
  runCount       Int              @default(0)
  successCount   Int              @default(0)
  failureCount   Int              @default(0)
  timeSavedMinutes Int            @default(0)
  lastRunAt      DateTime?
  lastStatus     ExecutionStatus?
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions   AutomationExecution[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model AutomationExecution {
  id             String          @id @default(cuid())
  organizationId String
  automationId   String
  status         ExecutionStatus
  triggerEvent   String
  matched        Boolean         @default(false)
  steps          Json            @default("[]")
  errorMessage   String?
  durationMs     Int             @default(0)
  entityType     String?
  entityId       String?
  entityLabel    String?
  triggeredBy    String          @default("scheduler")
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automation   Automation   @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
  @@index([automationId, startedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// INTEGRATIONS / PLATFORM EXTENSIBILITY
// ─────────────────────────────────────────────────────────────────────────────

model Integration {
  id             String              @id @default(cuid())
  organizationId String
  provider       String
  name           String
  category       IntegrationCategory
  status         IntegrationStatus   @default(DISCONNECTED)
  enabled        Boolean             @default(false)
  config         Json                @default("{}")
  credentialRef  String?
  secretPreview  String?
  scopes         String[]            @default([])
  syncFrequency  String              @default("hourly")
  syncDirection  String              @default("inbound")
  lastSyncAt     DateTime?
  nextSyncAt     DateTime?
  lastError      String?
  errorCount     Int                 @default(0)
  recordsSynced  Int                 @default(0)
  connectedById  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId, status])
}

model Webhook {
  id             String    @id @default(cuid())
  organizationId String
  url            String
  description    String?
  secret         String
  events         String[]  @default([])
  active         Boolean   @default(true)
  failureCount   Int       @default(0)
  lastDeliveryAt DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId, active])
}

model WebhookDelivery {
  id             String   @id @default(cuid())
  organizationId String
  webhookId      String
  event          String
  status         String
  responseCode   Int?
  durationMs     Int      @default(0)
  payload        Json     @default("{}")
  error          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  webhook      Webhook      @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([webhookId])
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  prefix         String
  keyHash        String    @unique
  scopes         String[]  @default(["read"])
  lastUsedAt     DateTime?
  requestCount   Int       @default(0)
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, revokedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// ANALYTICS / REPORTING
// ─────────────────────────────────────────────────────────────────────────────

model Metric {
  id             String            @id @default(cuid())
  organizationId String
  key            String
  label          String?
  value          Decimal           @db.Decimal(18, 4)
  unit           String            @default("EUR")
  granularity    MetricGranularity @default(DAY)
  dimensionKey   String            @default("all")
  dimension      Json?
  periodStart    DateTime
  source         String            @default("engine")
  computedAt     DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key, granularity, dimensionKey, periodStart])
  @@index([organizationId, key, periodStart])
}

model Report {
  id              String         @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  type            ReportType     @default(CUSTOM)
  config          Json           @default("{}")
  schedule        ReportSchedule @default(NONE)
  recipients      String[]       @default([])
  format          String         @default("csv")
  isShared        Boolean        @default(false)
  isPinned        Boolean        @default(false)
  lastGeneratedAt DateTime?
  lastRunDurationMs Int?
  runCount        Int            @default(0)
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId, type])
}

model UsageEvent {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  quantity       Int      @default(1)
  metadata       Json?
  recordedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, key, recordedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// BILLING
// ─────────────────────────────────────────────────────────────────────────────

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String             @unique
  plan               OrgPlan            @default(GROWTH)
  status             SubscriptionStatus @default(TRIALING)
  seats              Int                @default(10)
  seatPrice          Decimal            @default(0) @db.Decimal(10, 2)
  mrr                Decimal            @default(0) @db.Decimal(10, 2)
  currency           String             @default("EUR")
  billingInterval    String             @default("monthly")
  billingEmail       String?
  discountPercent    Int                @default(0)
  taxId              String?
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?
  canceledReason     String?
  stripeCustomerId   String?
  stripeSubscriptionId String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  /// Set for accounts-receivable invoices issued to a customer.
  /// Null for platform subscription invoices billed to the organization.
  customerId     String?
  number         String
  status         InvoiceStatus @default(OPEN)
  subtotal       Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  currency       String        @default("EUR")
  seats          Int           @default(0)
  periodStart    DateTime
  periodEnd      DateTime
  issuedAt       DateTime      @default(now())
  dueAt          DateTime
  paidAt         DateTime?
  hostedUrl      String?
  lineItems      Json          @default("[]")
  notes          String?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, dueAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// TRUST / OBSERVABILITY
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String
  actorId        String?
  actorName      String
  actorEmail     String?
  actorRole      String?
  action         String
  entityType     String
  entityId       String?
  entityLabel    String?
  before         Json?
  after          Json?
  diff           Json?
  severity       AuditSeverity @default(INFO)
  source         AuditSource   @default(WEB)
  ip             String?
  userAgent      String?
  requestId      String?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, actorId])
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String?
  type           NotificationType
  title          String
  body           String
  severity       Severity         @default(MEDIUM)
  entityType     String?
  entityId       String?
  actionUrl      String?
  metadata       Json?
  readAt         DateTime?
  readById       String?
  createdAt      DateTime         @default(now())
  expiresAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, userId, readAt])
}

model Job {
  id             String    @id @default(cuid())
  organizationId String?
  name           String
  type           String
  status         JobStatus @default(PENDING)
  payload        Json?
  result         Json?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  lastError      String?
  scheduledFor   DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?
  createdAt      DateTime  @default(now())

  @@index([status, scheduledFor])
  @@index([organizationId, name])
}
