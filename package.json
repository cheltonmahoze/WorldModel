{
  "name": "nexus-os",
  "version": "1.0.0",
  "private": true,
  "description": "Nexus OS \u2014 AI Revenue & Operations Intelligence Platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:start": "tsx scripts/dev-db.ts start",
    "db:stop": "tsx scripts/dev-db.ts stop",
    "db:push": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/run-seed.ts",
    "db:reset": "tsx scripts/dev-db.ts reset && tsx scripts/db-migrate.ts && tsx scripts/run-seed.ts",
    "generate": "tsx scripts/prisma-generate.ts",
    "setup": "tsx scripts/setup.ts",
    "worker": "tsx scripts/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/e2e.ts",
    "verify": "npm run typecheck && npm run test",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "migrate:generate": "tsx scripts/generate-migration.ts",
    "migrate:check": "tsx scripts/generate-migration.ts --check"
  },
  "prisma": {
    "seed": "tsx scripts/run-seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-accordion": "1.2.11",
    "@radix-ui/react-alert-dialog": "1.1.14",
    "@radix-ui/react-avatar": "1.1.10",
    "@radix-ui/react-checkbox": "1.3.2",
    "@radix-ui/react-collapsible": "1.1.11",
    "@radix-ui/react-dialog": "1.1.14",
    "@radix-ui/react-dropdown-menu": "2.1.15",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.14",
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-radio-group": "1.3.7",
    "@radix-ui/react-scroll-area": "1.2.9",
    "@radix-ui/react-select": "2.2.5",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slider": "1.3.5",
    "@radix-ui/react-switch": "1.2.5",
    "@radix-ui/react-tabs": "1.1.12",
    "@radix-ui/react-tooltip": "1.2.7",
    "@tanstack/react-query": "5.103.2",
    "bcryptjs": "2.4.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "jose": "5.10.0",
    "lucide-react": "1.47.0",
    "next": "15.5.25",
    "pg": "^8.13.1",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "react-hook-form": "7.54.2",
    "recharts": "2.15.4",
    "sonner": "2.0.8",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@prisma/internals": "^6.19.3",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "dotenv": "16.4.7",
    "embedded-postgres": "17.10.0-beta.17",
    "postcss": "8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
